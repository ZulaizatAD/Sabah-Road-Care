ENVIRONMENT=development
AUTO_CREATE_TABLES=false
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required: Supabase Postgres connection (Transaction pooler with SSL)
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<db-password>@<host>:6543/postgres?sslmode=require
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Required: JWT auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60

# Required: Supabase Storage for pothole images
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=pothole-images
SUPABASE_STORAGE_PREFIX=reports
SUPABASE_SIGNED_UPLOAD_EXPIRES_IN=900

# Optional: Gemini AI (if empty, backend uses fallback analysis)
GEMINI_API_KEY=

# Optional: AI queue retry tuning
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_SECONDS=5

# Optional local Postgres fallback (used only if DATABASE_URL is empty)
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sabah_road_care

# Optional legacy Cloudinary fallback
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

